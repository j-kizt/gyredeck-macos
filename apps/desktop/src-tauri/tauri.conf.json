{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gyredeck",
  "version": "1.2.1",
  "identifier": "com.j-kizt.gyredeck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:47622",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gyredeck",
        "width": 420,
        "height": 560,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' http://127.0.0.1:47621; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Gyredeck · J-Kitz",
    "createUpdaterArtifacts": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "../../../adapters/claude/gyredeck-claude-hook.mjs": "gyredeck-claude-hook.mjs",
      "../../../adapters/antigravity/gyredeck-agy-hook.mjs": "gyredeck-agy-hook.mjs",
      "../../../adapters/bridge/gyredeck-bridge.mjs": "gyredeck-bridge.mjs"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/j-kizt/gyredeck-macos/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2OUM4OTZFQjI0MEQxNEYKUldSUDBVQ3lib21jdG5uenY3QkErbmM4VG9UZllJNU1BVGlVQ2szNzdZUEZRNkkzNEtUR09ZQTMK"
    }
  }
}
