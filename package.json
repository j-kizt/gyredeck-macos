{
  "name": "gyredeck",
  "version": "1.4.0",
  "private": true,
  "description": "Local-first macOS menu-bar companion for AI coding agents — live sessions, provider usage, local services, and GitHub monitoring.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && pnpm --filter @gyredeck/desktop check",
    "hooks:install": "node scripts/install-claude-hooks.mjs",
    "gh:switch": "node scripts/gh-switch.mjs",
    "mod:tail": "tail -f ~/.config/gyredeck/gyredeck.events.ndjson",
    "viewer": "node apps/viewer/index.mjs",
    "desktop:dev": "pnpm --filter @gyredeck/desktop tauri:dev",
    "desktop:build": "pnpm --filter @gyredeck/desktop tauri:build",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:web": "pnpm --filter @gyredeck/desktop dev",
    "desktop:web:build": "pnpm --filter @gyredeck/desktop build",
    "benchmark:bridge": "node scripts/benchmark-bridge.mjs --events=20000",
    "benchmark:sessions": "node scripts/benchmark-session-model.mjs",
    "test:performance": "pnpm desktop:web:build && node scripts/check-performance-budget.mjs && node scripts/benchmark-session-model.mjs --assert && node scripts/benchmark-bridge.mjs --events=5000 --assert",
    "test:demo": "playwright test",
    "test:hooks": "node --test tests/hook-integration.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "25.0.0",
    "typescript": "5.9.3"
  }
}
